# ==============================================================================
# Environment Configuration Template
# Copy this file to '.env' and populate with your local/production credentials.
# NEVER commit the actual '.env' file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Option 1: Neon / PostgreSQL Connection URL (Recommended)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://neondb_owner:your_password@ep-your-subdomain.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# Option 2: MySQL Database Settings (Alternative)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fake_news_db
DB_USER=app_user
DB_PASSWORD=your_secure_password_here

# ------------------------------------------------------------------------------
# Option 3: SQLite Fallback
# Automatically used if DATABASE_URL or MySQL credentials are not configured.
# Database file location: outputs/fake_news.db
# ------------------------------------------------------------------------------
DB_TYPE=postgres

# Kaggle API Credentials (Optional: used for automatic dataset download)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Pipeline Execution Settings
EXPERIMENT_MODE=quick      # 'quick' (fast baseline tuning) or 'research' (full grid/transformer)
ENABLE_TRANSFORMERS=false  # Set to true if PyTorch & Transformers are installed with GPU
RANDOM_SEED=42
DATA_RAW_DIR=data/raw
ARTIFACTS_DIR=artifacts/models
OUTPUTS_DIR=outputs
